# OpenAI Python SDK 학습 덱 환경 변수 예시
# 복사하여 .env 생성: cp .env.example .env

# [경로 A: 로컬 Ollama 환경 (기본 / 무과금 / 오프라인)]
OPENAI_BASE_URL="http://localhost:11434/v1"
OPENAI_API_KEY="ollama"
OPENAI_MODEL="nemotron-3-nano:4b"

# [경로 B: 공식 OpenAI API (클라우드 서비스 / 유료 크레딧)]
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-5.6-luna"
