{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "claudecode": ["rules", "skills", "commands", "subagents"],
    "codexcli": ["rules", "skills", "subagents"],
    "copilot": ["rules", "skills", "commands", "subagents"],
    "copilotcli": ["rules", "skills", "subagents"],
    "antigravity-ide": ["rules", "skills", "commands", "subagents"],
    "antigravity-cli": ["rules", "skills", "commands", "subagents"],
    "agentsmd": ["rules"]
  },
  "sources": [
    {
      "source": "https://github.com/mols3131d/mols-agent-assets.git",
      "transport": "git",
      "ref": "main",
      "path": "src/rulesync/.rulesync/skills",
      "skills": [
        "guidance-context",
        "mols-clarify-code",
        "mols-agent-asset",
        "mols-agent-asset-find",
        "mols-ci-design",
        "mols-markdown-maintenance",
        "mols-mermaid-diagram",
        "mols-mermaid-chart",
        "mols-loops",
        "technical-document-fidelity",
        "mols-coding-context",
        "mols-coding-context-python",
        "mols-documentation",
        "text-humanize-korean",
        "mols-code-comprehension-refactor",
        "mols-project-task-command-design",
        "mols-dev-env-bootstrap-design"
      ]
    }
  ],
  "outputRoots": ["."],
  "delete": false,
  "gitignoreDestination": "gitexclude"
}
