{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": [
    "claudecode",
    "codexcli",
    "copilot",
    "copilotcli",
    "antigravity-ide",
    "antigravity-cli"
  ],
  "features": ["skills"],
  "sources": [
    {
      "source": "https://github.com/mols3131d/mols-agent-assets.git",
      "transport": "git",
      "ref": "main",
      "path": "src/rulesync/.rulesync/skills",
      "skills": [
        "guidance-context",
        "mols-clarify-code",
        "mols-agent-asset",
        "mols-agent-asset-find",
        "mols-chatbot-bootstrap",
        "mols-ci-design",
        "mols-markdown-maintenance",
        "mols-mermaid-diagram",
        "mols-mermaid-chart",
        "mols-loops",
        "technical-document-fidelity",
        "mols-coding-context",
        "mols-coding-context-python",
        "mols-documentation",
        "text-humanize-korean",
        "mols-code-comprehension-refactor"
      ]
    }
  ],
  "outputRoots": ["."],
  "delete": true
}
