root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[AGENTS.md]
insert_final_newline = false

[decks/AGENTS.md]
insert_final_newline = false

[decks/**/AGENTS.md]
insert_final_newline = false

[.agents/**/*.md]
insert_final_newline = false

[.github/copilot-instructions.md]
insert_final_newline = false

[.github/instructions/*.instructions.md]
insert_final_newline = false
