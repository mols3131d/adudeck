{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "adudeck: bootstrap",
      "type": "shell",
      "command": "mise install && mise run setup",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "adudeck: fix & check",
      "type": "shell",
      "command": "mise run ci:fast",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "adudeck: format",
      "type": "shell",
      "command": "mise run format",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "adudeck: list tasks",
      "type": "shell",
      "command": "mise tasks",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
